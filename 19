-- finder
local function GetChest()

    local island = Islands[getgenv().IslandIndex]

    if not island then

        getgenv().IslandIndex = 1

        island = Islands[1]
    end

    local nearest
    local dist = math.huge

    for _,v in pairs(workspace:GetDescendants()) do

        if string.find(v.Name:lower(),"chest") then

            local pos

            if v:IsA("BasePart") then
                pos = v.Position
            end

            if v:IsA("Model") then

                local p = v.PrimaryPart
                or v:FindFirstChildWhichIsA("BasePart",true)

                if p then
                    pos = p.Position
                end
            end

            if pos then

                local id = ChestID(pos)

                if not getgenv().LootedChests[id] then

                    local islandDist =
                        (island.Position - pos).Magnitude

                    if islandDist <= 900 then

                        local mag =
                            (HRP().Position - pos).Magnitude

                        if mag < dist then

                            dist = mag

                            nearest = {
                                obj = v,
                                pos = pos,
                                id = id
                            }
                        end
                    end
                end
            end
        end
    end

    if not nearest then

        Notify("Đổi đảo : "..island.Name)

        getgenv().IslandIndex += 1

        if getgenv().IslandIndex > #Islands then

            getgenv().IslandIndex = 1

            table.clear(getgenv().LootedChests)
        end

        local nextIsland =
            Islands[getgenv().IslandIndex]

        HRP().CFrame = CFrame.new(
            nextIsland.Position + Vector3.new(0,8,0)
        )

        task.wait(1.5)
    end

    return nearest
end

-- move
local function MoveTo(pos)

    local hrp = HRP()
    local hum = Hum()

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    if getgenv().FarmMode == "Teleport" then

        hrp.CFrame = CFrame.new(
            pos.X,
            pos.Y + 4,
            pos.Z
        )

        task.wait(0.18)

    else

        hum.PlatformStand = true

        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(
                (hrp.Position - pos).Magnitude / 220,
                Enum.EasingStyle.Linear
            ),
            {
                CFrame = CFrame.new(
                    pos.X,
                    pos.Y + 6,
                    pos.Z
                )
            }
        )

        tween:Play()
        tween.Completed:Wait()

        hum.PlatformStand = false
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

-- farm
task.spawn(function()


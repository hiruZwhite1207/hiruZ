local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- HÀM: Tạo quả cầu năng lượng mượt, không dùng PointLight để chống lóa như Screenshot_20260630-211815.jpg
local function createCleanBall(color, size, position)
    local core = Instance.new("Part")
    core.Shape = Enum.PartType.Ball
    core.Size = Vector3.new(size * 0.4, size * 0.4, size * 0.4)
    core.Color = color
    core.Material = Enum.Material.Neon -- Lõi neon nhỏ vừa phải để lấy màu sắc
    core.Anchored = true
    core.CanCollide = false
    core.Position = position
    core.Parent = workspace
    
    local aura = Instance.new("Part")
    aura.Shape = Enum.PartType.Ball
    aura.Size = Vector3.new(size, size, size)
    aura.Color = color
    aura.Material = Enum.Material.ForceField -- Vỏ cuộn năng lượng anime không phát sáng lóa
    aura.Anchored = true
    aura.CanCollide = false
    aura.CFrame = core.CFrame
    aura.Parent = core
    
    -- Xoay nhẹ vỏ năng lượng cho sinh động
    RunService.RenderStepped:Connect(function()
        if core.Parent then
            aura.CFrame = core.CFrame * CFrame.Angles(math.rad(math.random(-5,5)), math.rad(math.random(-5,5)), 0)
        end
    end)
    
    return core
end

-- 1. PHÍM Q: THƯƠNG (XANH) - Bay từ từ (1 giây)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Q then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local blueBall = createCleanBall(Color3.fromRGB(0, 100, 255), 3, hrp.Position + hrp.CFrame.LookVector * 6)
        local targetPos = blueBall.Position + hrp.CFrame.LookVector * 120
        
        local tween = TweenService:Create(blueBall, TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = targetPos
        })
        tween:Play()
        tween.Completed:Connect(function() blueBall:Destroy() end)
    end
end)


local CurrentButtons = {}

-- Hàm xóa sạch nút cũ để đổi Tab
local function ClearButtons()
	for _, v in ipairs(CurrentButtons) do
		v:Destroy()
	end
	table.clear(CurrentButtons)
end

-- Hàm tạo Nút Script và cấu hình click thực thi
local function CreateItem(itemData)
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(1, -5, 0, 40)
	Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
	Btn.Text = "  " .. itemData.Name
	Btn.TextColor3 = Color3.new(1, 1, 1)
	Btn.Font = Enum.Font.Gotham
	Btn.TextSize = 14
	Btn.TextXAlignment = Enum.TextXAlignment.Left
	Btn.Parent = Scroll

	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

	-- Hiệu ứng phản hồi di chuột (Hover Effect)
	Btn.MouseEnter:Connect(function()
		TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 42)}):Play()
	end)
	Btn.MouseLeave:Connect(function()
		TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(22, 22, 30)}):Play()
	end)

	-- Xử lý luồng tải Script an toàn (pcall + task.spawn)
	Btn.MouseButton1Click:Connect(function()
		Info.Text = "Đang kích hoạt: " .. itemData.Name
		Info.TextColor3 = Color3.fromRGB(0, 255, 204)
		
		if itemData.Link and itemData.Link ~= "" then
			task.spawn(function()
				local success, err = pcall(function()
					local func, loadErr = loadstring(itemData.Link)
					if func then
						func()
					else
						error(loadErr)
					end
				end)
				if not success then
					Info.Text = "Lỗi script: " .. tostring(err)
					Info.TextColor3 = Color3.fromRGB(255, 85, 85)
				end
			end)
		else
			Info.Text = "Script này hiện đang trống Link!"
			Info.TextColor3 = Color3.fromRGB(255, 170, 0)
		end
	end)

	table.insert(CurrentButtons, Btn)
end

-- Hàm render danh sách theo Tab
local function LoadCategory(cat)
	ClearButtons()
	if Categories[cat] then
		for _, item in ipairs(Categories[cat]) do
			CreateItem(item)
		end
	end
end


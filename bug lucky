-- 2. NÚT KÉO HÌNH TRÒN (TOGGLE SWITCH CHỈNH KÍCH THƯỚC MINI)
local SwitchTrack = Instance.new("TextButton", MainFrame)
SwitchTrack.Size = UDim2.new(0, 50, 0, 24) -- Thanh trượt nhỏ gọn
SwitchTrack.Position = UDim2.new(0.5, -25, 0.5, -2)
SwitchTrack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SwitchTrack.Text = ""
Instance.new("UICorner", SwitchTrack).CornerRadius = UDim.new(1, 0)

local SwitchCircle = Instance.new("Frame", SwitchTrack)
SwitchCircle.Size = UDim2.new(0, 20, 0, 20) -- Nút tròn mini
SwitchCircle.Position = UDim2.new(0, 2, 0.5, -10)
SwitchCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", SwitchCircle).CornerRadius = UDim.new(1, 0)

-- Trạng thái điều khiển độc lập
local isLuckyAuto = false

-- 3. HIỆU ỨNG GẠT NÚT MƯỢT MÀ
SwitchTrack.MouseButton1Click:Connect(function()
    isLuckyAuto = not isLuckyAuto
    
    local targetPos = isLuckyAuto and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    local targetColor = isLuckyAuto and Color3.fromRGB(35, 150, 40) or Color3.fromRGB(40, 40, 40)
    
    TweenService:Create(SwitchCircle, TweenInfo.new(0.15), {Position = targetPos}):Play()
    TweenService:Create(SwitchTrack, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
end)

-- 4. LOGIC AUTO RANDOM ĐỘC LẬP (KHÔNG CHỨA CHỨC NĂNG CŨ)
task.spawn(function()
    while true do
        task.wait(2) -- Tần suất quét lệnh
        if isLuckyAuto then
            pcall(function()
                local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")
                if remote then
                    -- Lệnh gọi Server thực hiện Gacha gốc của game
                    remote:InvokeServer("Cousin", "Buy")
                end
            end)
        end
    end
end)

-- Chống ngắt kết nối AFK khi treo máy
for _, v in pairs(getconnections(LocalPlayer.Idled)) do v:Disable() end

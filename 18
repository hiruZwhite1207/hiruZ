-- character
local function HRP()

    local char = plr.Character or plr.CharacterAdded:Wait()

    return char:WaitForChild("HumanoidRootPart")
end

-- chest id
local function ChestID(pos)

    return math.floor(pos.X)
    .."_"
    ..math.floor(pos.Y)
    .."_"
    ..math.floor(pos.Z)
end


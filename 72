-- 4.  Shop (Cần thay tên nút như đã dặn)
local shopping = false
ShopBtn.MouseButton1Click:Connect(function()
    shopping = not shopping
    ShopBtn.Text = shopping and "chợ đen: mở" or "chợ đen: đóng"
    ShopBtn.BackgroundColor3 = shopping and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 0, 0)
end)

task.spawn(function()
    while task.wait(2) do
        if shopping then
            local pg = LocalPlayer:WaitForChild("PlayerGui")
            -- Thay "Shop" và "Tool" bằng tên nút trong game của ông
            local btn1 = pg:FindFirstChild("Shop", true)
            local btn2 = pg:FindFirstChild("Tool", true)
            if btn1 and btn1:IsA("GuiButton") then VirtualInput:SendMouseButtonEvent(btn1.AbsolutePosition.X, btn1.AbsolutePosition.Y, 0, true, game, 1) end

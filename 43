--------------------------------------------------
-- CHARACTER & NOCLIP CHUẨN
--------------------------------------------------
local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Char = GetCharacter()
    return Char:WaitForChild("HumanoidRootPart")
end

local NoclipConnection
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local Char = LocalPlayer.Character
                if Char then
                    for _, v in ipairs(Char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

--------------------------------------------------
-- ITEM CHECK (Dừng tool nếu nhặt đồ hiếm)
--------------------------------------------------
local function CheckItems()
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local Character = LocalPlayer.Character

    for _, item in ipairs(SpecialItems) do
        if Backpack and Backpack:FindFirstChild(item) then return true, item end
        if Character and Character:FindFirstChild(item) then return true, item end
    end
    return false, nil
end

--------------------------------------------------
-- CHEST SCAN & LỌC TỐI ƯU
--------------------------------------------------
local function InitialChestScan()
    table.clear(CachedChests)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.lower(obj.Name):find("chest") then
            table.insert(CachedChests, obj)
        end
    end
end

local function GetNearestChest()
    local Root = GetRoot()
    if not Root then return nil end

    local nearest = nil
    local shortest = math.huge

    for i = #CachedChests, 1, -1 do
        local chest = CachedChests[i]
        -- Lọc bỏ mấy rương tàng hình/bị mất khỏi game
        if not chest or not chest.Parent then
            table.remove(CachedChests, i)
        else
            local dist = (Root.Position - chest.Position).Magnitude
            if dist < shortest then
                shortest = dist
                nearest = chest
            end
        end
    end
    return nearest
end

--------------------------------------------------
-- TỐC BIẾN BYPASS (CHIA NHỎ CHỐNG RUBBERBAND)
--------------------------------------------------
local function TP(targetPosition)
    local Root = GetRoot()
    if not Root then return end

    ToggleNoclip(true)

    local currentPos = Root.Position
    local distance = (currentPos - targetPosition).Magnitude
    local maxJump = 590 -- Chia nhỏ 590 studs/nhịp để không bị giật

    if distance > maxJump then
        local steps = math.ceil(distance / maxJump)
        for i = 1, steps do
            local lerpPos = currentPos:Lerp(targetPosition, i / steps)
            Root.CFrame = CFrame.new(lerpPos + Vector3.new(0, TELEPORT_HEIGHT, 0))
            Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            task.wait(0.01) -- Nghỉ rất ngắn để server cập nhật
        end
    else
        Root.CFrame = CFrame.new(targetPosition + Vector3.new(0, TELEPORT_HEIGHT, 0))
        Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    
    task.wait(TELEPORT_DELAY)
    ToggleNoclip(false)
end

--------------------------------------------------
-- COLLECT CHEST LOGIC (FIX LỖI ĐỨNG IM NHÌN 1 RƯƠNG)
--------------------------------------------------
local function CollectChest(chest)
    if not chest or not chest.Parent then return end

    UpdateStatus("Collecting " .. chest.Name)
    TP(chest.Position)

    -- Chạm rương
    pcall(function()
        if firetouchinterest then
            firetouchinterest(GetRoot(), chest, 0)
            task.wait(0.1)
            firetouchinterest(GetRoot(), chest, 1)
        else
            GetRoot().CFrame = chest.CFrame
        end
    end)
    
    UpdateCount()

    -- CHỐT HẠ FIX LỖI: Cưỡng ép xóa cái rương vừa nhặt ra khỏi bộ nhớ ngay lập tức!
    local index = table.find(CachedChests, chest)
    if index then
        table.remove(CachedChests, index)
    end

    task.wait(0.2)
end

--------------------------------------------------
-- SERVER HOP LOGIC
--------------------------------------------------
local function HopServer()
    UpdateStatus("No Chest Left! Finding Server...")

    local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function() return game:HttpGet(url) end)

    if not success then
        UpdateStatus("HTTP failed, retrying...")
        task.wait(3)
        return
    end

    local data = HttpService:JSONDecode(response)
    for _, server in ipairs(data.data) do
        -- Lọc server vắng (nhỏ hơn 10 người) để nhiều rương
        if server.id ~= game.JobId and server.playing < server.maxPlayers and server.playing <= 10 and not JoinedServers[server.id] then
            JoinedServers[server.id] = true
            SaveServers()
            UpdateStatus("Teleporting to Server...")
            task.wait(1)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
            break
        end
    end
end


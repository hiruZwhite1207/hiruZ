local TimeLabel = StatusGroup:AddLabel("Loading Time...")
local FPSLabel = StatusGroup:AddLabel("FPS : 0")
local PingLabel = StatusGroup:AddLabel("Ping : 0")

StatusGroup:AddDivider()

local MirageLabel = StatusGroup:AddLabel("Mirage Island : Checking...")
local KitsuneLabel = StatusGroup:AddLabel("Kitsune Island : Checking...")
local PrehistoricLabel = StatusGroup:AddLabel("Prehistoric Island : Checking...")
local FrozenLabel = StatusGroup:AddLabel("Frozen Dimension : Checking...")

StatusGroup:AddDivider()

local RipIndraLabel = StatusGroup:AddLabel("Rip_Indra : Checking...")
local DoughKingLabel = StatusGroup:AddLabel("Dough King : Checking...")
local EliteLabel = StatusGroup:AddLabel("Elite Hunter : Checking...")
local MoonLabel = StatusGroup:AddLabel("Moon : Checking...")

--========================
-- STATUS LOOP
--========================

task.spawn(function()
    while task.wait(1) do

        TimeLabel:SetText(os.date("%d/%m/%Y - %H:%M:%S [VN]"))

        FPSLabel:SetText("FPS : "..math.floor(workspace:GetRealPhysicsFPS()))

        PingLabel:SetText(
            "Ping : "..
            math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            .." ms"
        )

    end
end)

task.spawn(function()
    while task.wait(5) do

        local Enemies = workspace:FindFirstChild("Enemies")

        -- Mirage
        if workspace:FindFirstChild("Mirage Island") then
            MirageLabel:SetText("Mirage Island : ✅")
        else
            MirageLabel:SetText("Mirage Island : ❌")
        end

        -- Kitsune
        if workspace:FindFirstChild("Kitsune Island") then
            KitsuneLabel:SetText("Kitsune Island : ✅")
        else
            KitsuneLabel:SetText("Kitsune Island : ❌")
        end

        -- Prehistoric
        if workspace:FindFirstChild("Prehistoric Island") then
            PrehistoricLabel:SetText("Prehistoric Island : ✅")
        else
            PrehistoricLabel:SetText("Prehistoric Island : ❌")
        end

        -- Frozen
        if workspace:FindFirstChild("Frozen Dimension") then
            FrozenLabel:SetText("Frozen Dimension : ✅")
        else
            FrozenLabel:SetText("Frozen Dimension : ❌")
        end

        -- Bosses
        if Enemies then

            if Enemies:FindFirstChild("rip_indra True Form") then
                RipIndraLabel:SetText("Rip_Indra : ✅")
            else
                RipIndraLabel:SetText("Rip_Indra : ❌")
            end

            if Enemies:FindFirstChild("Dough King") then
                DoughKingLabel:SetText("Dough King : ✅")
            else
                DoughKingLabel:SetText("Dough King : ❌")
            end

        end

        -- Elite
        EliteLabel:SetText("Elite Hunter : "..tostring(LocalPlayer.Data.Fragments.Value))

        -- Moon
        local Lighting = game:GetService("Lighting")

        if Lighting.ClockTime >= 0 and Lighting.ClockTime <= 5 then
            MoonLabel:SetText("Moon : 🌕")
        else
            MoonLabel:SetText("Moon : 🌑")
        end

    end
end)


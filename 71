-- Teleport Thông Minh
TpButton.MouseButton1Click:Connect(function()
    local name = string.lower(TextBox.Text)
    if name == "" then return end
    for _, p in pairs(Players:GetPlayers()) do
        if string.sub(string.lower(p.Name), 1, #name) == name or string.sub(string.lower(p.DisplayName), 1, #name) == name then
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame
                break
            end
        end
    end
end)

-- Auto Farm Siêu Cấp
local auto = false
FarmButton.MouseButton1Click:Connect(function()
    auto = not auto
    FarmButton.Text = auto and "AUTO FARM: ON" or "AUTO FARM: OFF"
    FarmButton.BackgroundColor3 = auto and Color3.fromRGB(35, 150, 40) or Color3.fromRGB(150, 40, 40)
end)

task.spawn(function()
    while true do
        task.wait(0.2) -- Tốc độ quét (có thể chỉnh nhỏ hơn nếu muốn lẹ)
        if auto then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    -- Quét toàn bộ map để tìm vật phẩm có thể tương tác
                    for _, obj in pairs(workspace:GetDescendants()) do
                        -- Nếu game dùng phím E (ProximityPrompt)
                        if obj:IsA("ProximityPrompt") then
                            local distance = (obj.Parent.Position - char.HumanoidRootPart.Position).Magnitude
                            if distance <= obj.MaxActivationDistance then
                                fireproximityprompt(obj, 1)
                                fireproximityprompt(obj, 0)
                            end
                        -- Nếu game dùng Click chuột (ClickDetector)
                        elseif obj:IsA("ClickDetector") then
                            local distance = (obj.Parent.Position - char.HumanoidRootPart.Position).Magnitude
                            if distance <= obj.MaxActivationDistance then
                                fireclickdetector(obj)
                            end
                        end
                    end
                end
            end)
        end
    end
end)


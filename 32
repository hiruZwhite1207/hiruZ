-- 2. LOGIC KIỂM TRA BÁU VẬT & TỰ HỦY (SELF-DESTRUCT)
----------------------------------------------------------------------
function CheckBautVat()
    local BackPack = LocalPlayer:FindFirstChild("Backpack")
    local Character = LocalPlayer.Character
    
    -- Danh sách báu vật cần săn
    local BauVat = {"God's Chalice", "Fist of Darkness", "Chén Thánh", "Chìa Khóa Râu Đen"}
    
    for _, item in pairs(BauVat) do
        if (BackPack and BackPack:FindFirstChild(item)) or (Character and Character:FindFirstChild(item)) then
            UpdateStatus("ĐÃ NHẶT ĐƯỢC " .. string.upper(item) .. "! TỰ HỦY AUTO ĐỂ BẢO VỆ VẬT PHẨM!")
            wait(2)
            ScreenGui:Destroy() -- Xóa Menu hoàn toàn
            _G.AutoChest = false -- Tắt vòng lặp farm
            return true
        end
    end
    return false
end

----------------------------------------------------------------------
-- 3. BỘ LỌC SERVER (SERVER HOP - 4H+ & < 8 NGƯỜI)
----------------------------------------------------------------------
function HopServer()
    UpdateStatus("Đang tìm Server 4h+ và dưới 8 người...")
    wait(1)
    
    -- API lấy danh sách server công khai của game
    local GameID = game.PlaceId
    local ApiUrl = "https://games.roblox.com/v1/games/" .. GameID .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local Success, Result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(ApiUrl))
    end)
    
    if Success and Result and Result.data then
        for _, server in pairs(Result.data) do
            -- Kiểm tra: Server còn chỗ trống và số người chơi hiện tại dưới 8 người
            if server.playing and server.playing < 8 and server.id ~= game.JobId then
                -- Lưu ý: Check Server Age (4h+) trên Script cần đọc giá trị từ Workspace hoặc ước lượng qua log game
                UpdateStatus("Đã tìm thấy Server hợp lệ! Đang chuyển dòng thời gian...")
                TeleportService:TeleportToPlaceInstance(GameID, server.id, LocalPlayer)
                wait(5)
            end
        end
    end
    UpdateStatus("Không tìm thấy server phù hợp, thử lại sau...")
end


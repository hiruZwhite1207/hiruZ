--------------------------------------------------
-- LƯU LỊCH SỬ SERVER HOP (Chống vào lại server cũ)
--------------------------------------------------
local hopFile = "HIRUZ_ServerHop_V4.json"
local JoinedServers = {}

-- Đọc lịch sử server cũ (nếu có)
if isfile and isfile(hopFile) then
    pcall(function()
        local decoded = HttpService:JSONDecode(readfile(hopFile))
        if type(decoded) == "table" then
            JoinedServers = decoded
        end
    end)
end


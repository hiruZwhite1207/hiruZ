---------------------------------------------------
-- SETTINGS
---------------------------------------------------

_G.AutoChest = true

local SpecialItems = {
    "God's Chalice",
    "Fist of Darkness",
    "Chén Thánh",
    "Chìa Khóa Râu Đen"
}

---------------------------------------------------
-- CHECK ITEMS
---------------------------------------------------

function CheckSpecialItems()

    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local Character = LocalPlayer.Character

    for _,item in pairs(SpecialItems) do

        if Backpack and Backpack:FindFirstChild(item) then
            return true,item
        end

        if Character and Character:FindFirstChild(item) then
            return true,item
        end
    end

    return false,nil
end

---------------------------------------------------
-- GET ALL CHESTS
---------------------------------------------------

function GetAllChests()

    local chests = {}

    for _,obj in pairs(workspace:GetDescendants()) do

        if obj:IsA("BasePart") then

            local name = string.lower(obj.Name)

            if string.find(name,"chest") then
                table.insert(chests,obj)
            end
        end
    end

    return chests
end

---------------------------------------------------
-- TELEPORT
---------------------------------------------------

function TP(cf)

    local Character = LocalPlayer.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    Root.CFrame = cf + Vector3.new(0,3,0)
end

---------------------------------------------------
-- SERVER HOP
---------------------------------------------------

local JoinedServers = {}

function HopServer()

    UpdateStatus("Đang tìm server mới...")

    local url =
        "https://games.roblox.com/v1/games/"..
        game.PlaceId..
        "/servers/Public?sortOrder=Asc&limit=100"

    local success,result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if success and result and result.data then

        for _,server in pairs(result.data) do

            if server.playing < 8
            and server.id ~= game.JobId
            and not JoinedServers[server.id] then

                JoinedServers[server.id] = true

                UpdateStatus("Đang hop server...")

                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    LocalPlayer
                )

                wait(5)
            end
        end
    end
end

---------------------------------------------------
-- MAIN
---------------------------------------------------

task.spawn(function()

    while _G.AutoChest do
        task.wait(0.15)

        ---------------------------------------------
        -- CHECK SPECIAL ITEM
        ---------------------------------------------

        local HasItem,ItemName = CheckSpecialItems()

        if HasItem then

            UpdateStatus("Đã nhặt "..ItemName.." | Auto dừng")

            _G.AutoChest = false

            break
        end

        ---------------------------------------------
        -- GET CHESTS
        ---------------------------------------------

        local Chests = GetAllChests()

        ---------------------------------------------
        -- IF HAVE CHESTS
        ---------------------------------------------

        if #Chests > 0 then

            for _,Chest in pairs(Chests) do

                if Chest and Chest.Parent then

                    UpdateStatus("Đang nhặt "..Chest.Name)

                    TP(Chest.CFrame)

                    task.wait(0.4)
                end
            end

        else

            -----------------------------------------
            -- RESET CHARACTER
            -----------------------------------------

            UpdateStatus("Đảo hết rương | Reset đổi đảo")

            local Character = LocalPlayer.Character

            if Character and Character:FindFirstChild("Humanoid") then

                Character.Humanoid.Health = 0
            end

            task.wait(6)

            -----------------------------------------
            -- CHECK AGAIN
            -----------------------------------------

            if #GetAllChests() <= 0 then

                UpdateStatus("Map vẫn hết rương | Hop server")

                HopServer()
            end
        end
    end
end)

UpdateStatus("HIRUZ HUB Loaded")

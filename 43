task.spawn(function()
    while getgenv().AutoChest do
        local HasItem, ItemName = CheckItems()

        if HasItem then
            UpdateStatus("FOUND " .. ItemName .. "! STOPPING.")
            getgenv().AutoChest = false
            break
        end

        local Chest = GetNearestChest()

        if Chest then
            CollectChest(Chest)
        else
            HopServer()
            task.wait(10) -- Nghỉ chờ load server mới
        end
        
        task.wait(SEARCH_DELAY)
    end
end)

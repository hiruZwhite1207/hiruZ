-- Hệ thống tìm kiếm Real-time chuẩn xác
Search:GetPropertyChangedSignal("Text"):Connect(function()
	local txt = Search.Text:lower()
	for _, v in ipairs(CurrentButtons) do
		local cleanText = string.gsub(v.Text, "^%s+", ""):lower() -- Loại bỏ khoảng trắng đầu dòng

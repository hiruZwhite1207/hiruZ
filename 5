local function GetMoonPhase()

    local Time = Lighting.ClockTime

    if Time >= 0 and Time <= 1 then
        return "🌕 5/5"
    elseif Time <= 2 then
        return "🌖 4/5"
    elseif Time <= 3 then
        return "🌗 3/5"
    elseif Time <= 4 then
        return "🌘 2/5"
    else
        return "🌑 1/5"
    end
end

local function UpdateStatus()

    -- MIRAGE
    local Mirage =
        Workspace:FindFirstChild("_WorldOrigin")
        and Workspace._WorldOrigin:FindFirstChild("Locations")
        and Workspace._WorldOrigin.Locations:FindFirstChild("Mirage Island")

    MirageLabel:SetText(
        "Mirage Island : "..(Mirage and "✅" or "❌")
    )

    -- KITSUNE
    local Kitsune =
        Workspace:FindFirstChild("Map")
        and Workspace.Map:FindFirstChild("KitsuneIsland")

    KitsuneLabel:SetText(
        "Kitsune Island : "..(Kitsune and "✅" or "❌")
    )

    -- PREHISTORIC
    local Prehistoric =
        Workspace:FindFirstChild("Map")
        and Workspace.Map:FindFirstChild("PrehistoricIsland")

    PrehistoricLabel:SetText(
        "Prehistoric Island : "..(Prehistoric and "✅" or "❌")
    )

    -- FROZEN
    local Frozen =
        Workspace:FindFirstChild("Map")
        and Workspace.Map:FindFirstChild("FrozenDimension")

    FrozenLabel:SetText(
        "Frozen Dimension : "..(Frozen and "✅" or "❌")
    )

    -- RIP INDRA
    local RipIndra =
        Workspace.Enemies:FindFirstChild("rip_indra True Form")
        or Workspace.Enemies:FindFirstChild("rip_indra")

    RipIndraLabel:SetText(
        "Rip Indra : "..(RipIndra and "✅" or "❌")
    )

    -- DOUGH KING
    local DoughKing =
        Workspace.Enemies:FindFirstChild("Dough King")

    DoughKingLabel:SetText(
        "Dough King : "..(DoughKing and "✅" or "❌")
    )

    -- ELITE
    local Elite =
        Workspace.Enemies:FindFirstChild("Diablo")
        or Workspace.Enemies:FindFirstChild("Urban")
        or Workspace.Enemies:FindFirstChild("Deandre")

    EliteLabel:SetText(
        "Elite Hunter : "..(Elite and "✅" or "❌")
    )

    -- MOON
    MoonLabel:SetText(
        "Moon : "..GetMoonPhase()
    )
end

task.spawn(function()
    while task.wait(5) do
        pcall(UpdateStatus)
    end
end)


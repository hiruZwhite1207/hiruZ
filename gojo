-- 4. PHÍM Y: HƯ THỨC TỬ 200% (MÀN TỤ LỰC KHỔNG LỒ)
local isCasting200 = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Y and not isCasting200 then
        isCasting200 = true
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then isCasting200 = false return end
        
        -- Tạo 2 quả cầu Đỏ và Xanh siêu to khổng lồ
        local leftBlue = createFancyBall(Color3.fromRGB(0, 150, 255), 8, hrp.Position + (hrp.CFrame.RightVector * -15) + (hrp.CFrame.LookVector * 10))
        local rightRed = createFancyBall(Color3.fromRGB(255, 20, 50), 8, hrp.Position + (hrp.CFrame.RightVector * 15) + (hrp.CFrame.LookVector * 10))
        
        -- Rung màn hình nhẹ khi đang tụ lực
        cameraShake(2, 0.5)
        task.wait(1.5)
        
        -- Ép 2 quả cầu lại cực mạnh
        local midPos = hrp.Position + hrp.CFrame.LookVector * 15
        TweenService:Create(leftBlue, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Position = midPos}):Play()
        TweenService:Create(rightRed, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Position = midPos}):Play()
        
        task.wait(0.5)
        leftBlue:Destroy()
        rightRed:Destroy()
        
        -- VỤ NỔ 200% KÈM RUNG MÀN HÌNH MẠNH
        cameraShake(1.5, 3)
        local megaPurple = createFancyBall(Color3.fromRGB(200, 0, 255), 25, midPos)
        local targetPos = megaPurple.Position + hrp.CFrame.LookVector * 400 -- Bay siêu xa
        
        -- Hiệu ứng bay đi càn quét
        local tweenMega = TweenService:Create(megaPurple, TweenInfo.new(2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = targetPos,
            Size = Vector3.new(60, 60, 60) -- Kích thước khổng lồ
        })
        tweenMega:Play()
        
        tweenMega.Completed:Connect(function() 
            megaPurple:Destroy() 
            isCasting200 = false
        end)
    end
end)


local function SetupCategory(Groupbox, CategoryData)
    for _, scriptData in ipairs(CategoryData) do
        Groupbox:AddButton({
            Text = scriptData.Name,
            Func = function()
                Library:Notify({
                    Title = "Hệ thống",
                    Description = "Đang chạy: " .. scriptData.Name,
                    Duration = 3
                })
                task.spawn(function()
                    pcall(function()
                        local func = loadstring(scriptData.Link)
                        if func then func() end
                    end)
                end)
            end
        })
    end
end


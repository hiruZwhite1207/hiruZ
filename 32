_G.AutoChest = true

task.spawn(function()
    while _G.AutoChest do
        task.wait(0.1)
        
        -- Bước 1: Luôn kiểm tra xem có cầm Chén/Key không trước khi đi nhặt tiếp
        if CheckBautVat() then break end
        
        -- Bước 2: Tìm rương trên đảo hiện tại
        local TargetChest = nil
        for _, obj in pairs(workspace:GetChildren()) do
            if string.find(obj.name, "Chest") and obj:IsA("BasePart") then
                TargetChest = obj
                break
            end
        end
        
        -- Bước 3: Di chuyển hoặc Reset đổi đảo
        if TargetChest then
            UpdateStatus("Phát hiện rương: " .. TargetChest.Name .. ". Tiến hành thu thập...")
            
            -- Teleport mượt bằng CFrame đến rương
            local RootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if RootPart then
                RootPart.CFrame = TargetChest.CFrame
                task.wait(0.3) -- Đợi 0.3s để game nhận dữ liệu nhặt tiền
            end
        else
            -- ĐẢO HẾT RƯƠNG -> RESET NHÂN VẬT ĐỂ QUA ĐẢO MỚI/HOP SERVER
            UpdateStatus("Đảo hết rương! Reset nhân vật để chuyển đổi...")
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.Health = 0 -- Lệnh tự tử để reset nhanh
                task.wait(4) -- Chờ hồi sinh
            end
            
            -- Sau khi reset mà map vẫn trống -> Tiến hành nhảy server
            HopServer()
        end
    end
end)


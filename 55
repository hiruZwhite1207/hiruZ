-- 2. HÀM CHẠY SCRIPT CHỐNG LAG DELTA X
-- ==========================================
local function RunScript(Name, Link)
    Library:Notify({
        Title = "Đang Tải: " .. Name,
        Description = "Delta X đang xử lý mã, vui lòng đợi...",
        Duration = 3
    })
    task.spawn(function()
        pcall(function()
            local func = loadstring(game:HttpGet(Link) or Link)
            if func then func() else loadstring(Link)() end
        end)
    end)
end

local function SetupCategory(Groupbox, CategoryData)
    for _, scriptData in ipairs(CategoryData) do
        Groupbox:AddButton({
            Text = scriptData[1],
            Func = function() RunScript(scriptData[1], scriptData[2]) end
        })
    end
end


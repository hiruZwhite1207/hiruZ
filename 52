local ScriptTab = Window:AddTab("Blox Fruits")

-- Chia làm 2 cột (Left và Right) cho gọn
local KaitunGroup = ScriptTab:AddLeftGroupbox("Kaitun Scripts")
local VNGroup = ScriptTab:AddLeftGroupbox("Vietnam Scripts")

local GlobalGroup = ScriptTab:AddRightGroupbox("Global Scripts")
local UtilsGroup = ScriptTab:AddRightGroupbox("Utility Scripts")
local PremiumGroup = ScriptTab:AddRightGroupbox("Premium Scripts")

-- Hàm tự động tạo nút từ Data
local function SetupCategory(Groupbox, CategoryData)
    for _, scriptData in ipairs(CategoryData) do
        Groupbox:AddButton({
            Text = scriptData.Name,
            Func = function()
                -- Hiện thông báo góc màn hình
                Library:Notify({
                    Title = "Đang tải Script...",
                    Description = "Chuẩn bị khởi chạy: " .. scriptData.Name,
                    Duration = 3
                })
                
                -- Luồng chạy script an toàn
                task.spawn(function()
                    local success, err = pcall(function()
                        local func = loadstring(scriptData.Link)
                        if func then
                            func()
                        end
                    end)
                    if not success then
                        Library:Notify({
                            Title = "Lỗi!",
                            Description = "Không thể chạy script này: " .. tostring(err),
                            Duration = 5
                        })
                    end
                end)
            end
        })
    end
end

-- Bắt đầu tạo các nút
SetupCategory(KaitunGroup, Categories.Kaitun)
SetupCategory(VNGroup, Categories.VietNam)
SetupCategory(GlobalGroup, Categories.Global)
SetupCategory(UtilsGroup, Categories.Utility)
SetupCategory(PremiumGroup, Categories.Premium)


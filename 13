-- button system
local currentY = 80

local function CreateButton(name, callback)

    local button = Instance.new("TextButton")
    button.Parent = sidebar

    button.Size = UDim2.new(1,-20,0,42)
    button.Position = UDim2.new(0,10,0,currentY)

    button.BackgroundColor3 = Color3.fromRGB(30,30,30)
    button.BorderSizePixel = 0

    button.Text = name
    button.Font = Enum.Font.GothamBold
    button.TextSize = 16
    button.TextColor3 = Theme.Text

    Instance.new("UICorner", button).CornerRadius = UDim.new(0,10)

    button.MouseEnter:Connect(function()

        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Accent
            }
        ):Play()

    end)

    button.MouseLeave:Connect(function()

        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(30,30,30)
            }
        ):Play()

    end)

    button.MouseButton1Click:Connect(function()

        callback()
        Notify(name)

    end)

    currentY += 55
end

-- training systems
local Training = {}

function Training:GetBall()

    for _,v in pairs(workspace:GetChildren()) do

        if v.Name == "Ball" then
            return v
        end

    end
end

function Training:CreateESP(ball)

    if ball:FindFirstChild("HIRUZ_ESP") then
        return
    end

    local hl = Instance.new("Highlight")
    hl.Name = "HIRUZ_ESP"

    hl.FillColor = Theme.Accent
    hl.OutlineColor = Color3.new(1,1,1)

    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = ball

end

function Training:Update()

    local char = player.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ball = self:GetBall()

    if not ball then
        info.Text = "No Ball Found"
        return
    end

    if Config.BallESP then
        self:CreateESP(ball)
    end

    local distance =
        (ball.Position - hrp.Position).Magnitude

    local velocity =
        ball.AssemblyLinearVelocity.Magnitude

    local text =
        "Distance : "..math.floor(distance).."\n"

    if Config.ShowVelocity then
        text = text ..
            "Velocity : "..math.floor(velocity).."\n"
    end

    if distance <= Config.DistanceWarn then
        text = text .. "⚠ TIMING WINDOW"
    end

    info.Text = text

end


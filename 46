---------------------------------------------------
-- CHARACTER & NOCLIP
---------------------------------------------------
local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Char = GetCharacter()
    return Char:WaitForChild("HumanoidRootPart")
end

local NoclipConnection
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local Char = LocalPlayer.Character
                if Char then
                    for _, v in ipairs(Char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

---------------------------------------------------
-- ITEM CHECK
---------------------------------------------------
local function CheckSpecialItems()
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local Character = GetCharacter()

    for _,item in ipairs(SpecialItems) do
        if Backpack and Backpack:FindFirstChild(item) then return true,item end
        if Character and Character:FindFirstChild(item) then return true,item end
    end
    return false,nil
end

---------------------------------------------------
-- GET CHESTS
---------------------------------------------------
local function GetAllChests()
    local Chests = {}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(string.lower(obj.Name),"chest") then
            if obj.Parent then
                table.insert(Chests,obj)
            end
        end
    end

    table.sort(Chests,function(a,b)
        local Root = GetRoot()
        if Root then
            return (Root.Position - a.Position).Magnitude < (Root.Position - b.Position).Magnitude
        end
        return false
    end)
    return Chests
end

---------------------------------------------------
-- TỐC BIẾN BYPASS (CHỐNG KICK) + FIRETOUCHINTEREST
---------------------------------------------------
local function TPChest(chest)
    local Root = GetRoot()
    if not Root then return end

    ToggleNoclip(true)

    local currentPos = Root.Position
    local targetPosition = chest.Position
    local distance = (currentPos - targetPosition).Magnitude
    
    local maxJump = 350 -- Hãm phanh 350 chống kick
    local delayTime = 0.03
    
    if distance > maxJump then
        local steps = math.ceil(distance / maxJump)
        for i = 1, steps do
            local lerpPos = currentPos:Lerp(targetPosition, i / steps)
            Root.CFrame = CFrame.new(lerpPos + Vector3.new(0, 3, 0))
            Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            task.wait(delayTime) 
        end
    else
        Root.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
        Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    
    task.wait(0.15)
    
    -- HÀM ĂN RƯƠNG ÔNG VỪA TÌM ĐƯỢC ĐÂY
    pcall(function()
        if firetouchinterest then
            firetouchinterest(Root, chest, 0)
            task.wait(0.05)
            firetouchinterest(Root, chest, 1)
        end
    end)
    
    ToggleNoclip(false)
end

---------------------------------------------------
-- RESET
---------------------------------------------------
local function ResetCharacter()
    local Char = GetCharacter()
    local Humanoid = Char:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        UpdateStatus("Reset character (Anti-Cheat Bypass)...")
        Humanoid.Health = 0
        LocalPlayer.CharacterAdded:Wait()
        task.wait(3)
        ChestsCollectedSinceReset = 0 -- Trả nợ server xong, reset bộ đếm
    end
end

---------------------------------------------------
-- SERVER HOP (FIX LỖI 773)
---------------------------------------------------
local function HopServer()
    UpdateStatus("Searching new server...")
    local URL = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    
    local success,response = pcall(function() return game:HttpGet(URL) end)
    if not success then return end

    local data = HttpService:JSONDecode(response)
    for _,server in ipairs(data.data) do
        if server.playing < server.maxPlayers and server.playing <= 7 and server.id ~= game.JobId and not JoinedServers[server.id] then
            JoinedServers[server.id] = true
            UpdateStatus("Teleporting...")
            task.wait(3) -- Nghỉ 3s chống văng 773
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
            break
        end
    end
end


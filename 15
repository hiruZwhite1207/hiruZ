--// Farm
task.spawn(function()
    while task.wait(0.15) do
        pcall(function()

            if getgenv().AutoChest then

                local chest = GetNearestChest()

                if chest then

                    TweenTo(chest.pos + Vector3.new(0,3,0))

                    task.wait(0.4)

                    getgenv().Collected[chest.obj] = true
                else
                    table.clear(getgenv().Collected)
                end
            end
        end)
    end
end)

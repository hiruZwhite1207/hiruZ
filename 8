LocalGroup:AddButton({
    Text = "Boost FPS",

    Func = function()

        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

        for _,v in pairs(game:GetDescendants()) do

            if v:IsA("BasePart") then
                v.Material = Enum.Material.Plastic
                v.Reflectance = 0
            end

            if v:IsA("Texture")
            or v:IsA("Decal") then

                v:Destroy()

            end
        end
    end
})


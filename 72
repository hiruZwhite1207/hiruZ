-- 1. INF MONEY (Visual Only)
InfBtn.MouseButton1Click:Connect(function()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, stat in pairs(ls:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                stat.Value = 9999999999999999999999999999999999999999999 -- Chỉnh số dư hiển thị
            end
        end
        InfBtn.Text = "MONEY UPDATED!"
        task.wait(1)
        InfBtn.Text = "VISUAL INF MONEY"
    end
end)

-- 2. Teleport
TpBtn.MouseButton1Click:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), string.lower(Input.Text)) then
            LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame
        end
    end
end)


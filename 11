--// =========================

CombatTab:CreateToggle({
    Name = "Auto Parry (AI)",
    Callback = function(v)
        Settings.AutoParry = v
    end
})

CombatTab:CreateToggle({
    Name = "Auto Dodge",
    Callback = function(v)
        Settings.AutoDodge = v
    end
})

CombatTab:CreateToggle({
    Name = "Panic Parry",
    Callback = function(v)
        Settings.PanicParry = v
    end
})

VisualTab:CreateDropdown({
    Name = "Sword Skin",
    Options = {"Blue","Red","Green"},
    Callback = function(v)
        Settings.SwordSkin = v
    end
})

VisualTab:CreateToggle({
    Name = "Shader",
    Callback = function(v)
        Settings.Shader = v
        if v then enableShader() else disableShader() end
    end
})


-- finder
local function GetChest()

    local hrp = HRP()

    local nearest = nil
    local dist = math.huge

    for _,v in pairs(workspace:GetDescendants()) do

        if string.find(v.Name:lower(),"chest") then

            local pos

            if v:IsA("BasePart") then
                pos = v.Position
            end

            if v:IsA("Model") then

                local part = v.PrimaryPart
                or v:FindFirstChildWhichIsA("BasePart",true)

                if part then
                    pos = part.Position
                end
            end

            if pos then

                local id = ChestID(pos)

                if not getgenv().LootedChests[id] then

                    local mag = (hrp.Position - pos).Magnitude

                    if mag < dist then

                        dist = mag

                        nearest = {
                            obj = v,
                            pos = pos,
                            id = id
                        }
                    end
                end
            end
        end
    end

    return nearest
end

-- move
local function MoveTo(pos)

    local hrp = HRP()

    if getgenv().FarmMode == "Teleport" then

        hrp.CFrame = CFrame.new(
            pos + Vector3.new(
                math.random(-2,2),
                2,
                math.random(-2,2)
            )
        )

    else

        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(
                (hrp.Position - pos).Magnitude / 250,
                Enum.EasingStyle.Linear
            ),
            {
                CFrame = CFrame.new(pos + Vector3.new(0,2,0))
            }
        )

        tween:Play()
        tween.Completed:Wait()
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

-- farm
task.spawn(function()

    while task.wait(0.15) do

        pcall(function()

            if getgenv().AutoChest then

                local chest = GetChest()

                if chest then

                    Notify("Đang qua rương khác")

                    MoveTo(chest.pos)

                    getgenv().LootedChests[chest.id] = true

                    task.wait(math.random(12,18)/100)

                else

                    table.clear(getgenv().LootedChests)

                    Notify("Đang tìm rương mới")

                    task.wait(2)
                end
            end
        end)
    end
end)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local VirtualInput = game:GetService("VirtualInputManager")

-- Tạo UI Sang Chảnh
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
ScreenGui.Name = "HiruzHub"

local function createRoundedFrame(parent, size, pos)
    local frame = Instance.new("Frame", parent)
    frame.Size = size; frame.Position = pos
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    local corner = Instance.new("UICorner", frame); corner.CornerRadius = UDim.new(0, 15)
    local stroke = Instance.new("UIStroke", frame); stroke.Color = Color3.fromRGB(255, 255, 255); stroke.Thickness = 2
    return frame
end

local Main = createRoundedFrame(ScreenGui, UDim2.new(0, 250, 0, 350), UDim2.new(0, 50, 0.5, -175))
Main.Draggable = true

-- Title
local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1, 0, 0, 50); Title.Text = "HIRUZ HUB [PREMIUM]"
Title.TextColor3 = Color3.fromRGB(255, 255, 255); Title.BackgroundTransparency = 1; Title.Font = Enum.Font.GothamBold

-- Buttons
local function createBtn(text, pos, color)
    local btn = Instance.new("TextButton", Main)
    btn.Size = UDim2.new(0.8, 0, 0, 40); btn.Position = pos
    btn.Text = text; btn.BackgroundColor3 = color; btn.TextColor3 = Color3.fromRGB(255,255,255)
    Instance.new("UICorner", btn)
    return btn
end

local Input = Instance.new("TextBox", Main)
Input.Size = UDim2.new(0.8, 0, 0, 40); Input.Position = UDim2.new(0.1, 0, 0.15, 0)
Input.PlaceholderText = "Tên người chơi..."; Input.BackgroundColor3 = Color3.fromRGB(30,30,30)
Instance.new("UICorner", Input)

local TpBtn = createBtn("TELEPORT", UDim2.new(0.1, 0, 0.3, 0), Color3.fromRGB(0, 100, 255))
local FarmBtn = createBtn("AUTO FARM: OFF", UDim2.new(0.1, 0, 0.45, 0), Color3.fromRGB(200, 0, 0))
local ShopBtn = createBtn("AUTO SHOP: OFF", UDim2.new(0.1, 0, 0.6, 0), Color3.fromRGB(200, 0, 0))
local InfBtn = createBtn("VISUAL INF MONEY", UDim2.new(0.1, 0, 0.75, 0), Color3.fromRGB(150, 0, 200))


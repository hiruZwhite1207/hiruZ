local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- Hàm tạo rung màn hình (Camera Shake) cho chiêu có lực
local function cameraShake(duration, intensity)
    local startTime = os.clock()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if os.clock() - startTime < duration then
            local offsetX = (math.random() - 0.5) * intensity
            local offsetY = (math.random() - 0.5) * intensity
            Camera.CFrame = Camera.CFrame * CFrame.Angles(math.rad(offsetX), math.rad(offsetY), 0)
        else
            connection:Disconnect()
        end
    end)
end

-- Hàm tạo quả cầu năng lượng siêu đẹp (Có lõi sáng + Hạt Particle)
local function createFancyBall(color, size, position)
    local ball = Instance.new("Part")
    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(size, size, size)
    ball.Color = color
    ball.Material = Enum.Material.Neon
    ball.Anchored = true
    ball.CanCollide = false
    ball.Position = position
    ball.Parent = workspace
    
    -- Ánh sáng tỏa ra
    local light = Instance.new("PointLight", ball)
    light.Color = color
    light.Range = size * 4
    light.Brightness = 8
    
    -- Hạt năng lượng bao quanh
    local attachment = Instance.new("Attachment", ball)
    local particles = Instance.new("ParticleEmitter", attachment)
    particles.Color = ColorSequence.new(color)
    particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size/3), NumberSequenceKeypoint.new(1, 0)})
    particles.Texture = "rbxassetid://281983280" -- Texture hạt sáng cơ bản của Roblox
    particles.LockedToPart = true
    particles.Rate = 100
    particles.Speed = NumberRange.new(0.5, 2)
    particles.Lifetime = NumberRange.new(0.5, 1)
    
    return ball
end

-- 1. PHÍM Q: THƯƠNG (XANH - BLUE)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Q then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local blueBall = createFancyBall(Color3.fromRGB(0, 150, 255), 2, hrp.Position + hrp.CFrame.LookVector * 6)
        
        local tween = TweenService:Create(blueBall, TweenInfo.new(0.6, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Size = Vector3.new(8, 8, 8),
            Transparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function() blueBall:Destroy() end)
    end
end)


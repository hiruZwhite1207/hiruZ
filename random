-- Trạng thái
local isLuckyAuto = false
local TweenService = game:GetService("TweenService")

-- 3. LOGIC DI CHUYỂN NÚT KÉO & BẬT/TẮT
SwitchTrack.MouseButton1Click:Connect(function()
    isLuckyAuto = not isLuckyAuto
    
    local targetPos = isLuckyAuto and UDim2.new(1, -28, 0.5, -13) or UDim2.new(0, 2, 0.5, -13)
    local targetColor = isLuckyAuto and Color3.fromRGB(35, 150, 40) or Color3.fromRGB(40, 40, 40)
    
    -- Hiệu ứng mượt mà khi gạt công tắc
    TweenService:Create(SwitchCircle, TweenInfo.new(0.2), {Position = targetPos}):Play()
    TweenService:Create(SwitchTrack, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
end)

-- 4. CORE BUG LUCKY GACHA (AUTO RANDOM + STORE)
task.spawn(function()
    while true do
        task.wait(2) -- Quét liên tục mỗi 2 giây
        if isLuckyAuto then
            pcall(function()
                local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")
                if remote then
                    -- Lệnh thực hiện Gacha
                    local result = remote:InvokeServer("Cousin", "Buy")
                    
                    -- Nếu Gacha thành công và trả về Trái ác quỷ, tự động thực hiện chuỗi tối ưu:
                    if result then
                        task.wait(0.5)
                        -- Tìm trái ác quỷ trong người và tự động cất vào kho (Tránh bị cướp/out game mất)
                        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") and string.find(tool.Name, "Fruit") then
                                remote:InvokeServer("StoreFruit", tool.Name, tool)
                            end
                        end
                        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
                            if tool:IsA("Tool") and string.find(tool.Name, "Fruit") then
                                remote:InvokeServer("StoreFruit", tool.Name, tool)
                            end
                        end
                    end
                end
            end)
        end
    end
end)


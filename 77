-- 3. PHÍM R: HƯ THỨC TỬ 100% - Ép từ từ rồi bắn chậm rãi
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local leftBlue = createCleanBall(Color3.fromRGB(0, 100, 255), 3, hrp.Position + (hrp.CFrame.RightVector * -5) + (hrp.CFrame.LookVector * 6))
        local rightRed = createCleanBall(Color3.fromRGB(255, 0, 50), 3, hrp.Position + (hrp.CFrame.RightVector * 5) + (hrp.CFrame.LookVector * 6))
        
        local midPos = hrp.Position + hrp.CFrame.LookVector * 7
        TweenService:Create(leftBlue, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = midPos}):Play()
        TweenService:Create(rightRed, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = midPos}):Play()
        
        task.wait(0.6)
        leftBlue:Destroy()
        rightRed:Destroy()
        
        local purpleBall = createCleanBall(Color3.fromRGB(140, 0, 255), 12, midPos)
        local targetPos = purpleBall.Position + hrp.CFrame.LookVector * 180
        
        local tween = TweenService:Create(purpleBall, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = targetPos
        })
        tween:Play()
        tween.Completed:Connect(function() purpleBall:Destroy() end)
    end
end)

-- 4. PHÍM Y: HƯ THỨC TỬ 200% - CHUẨN MANGA (TỤ TRÊN ĐẦU SIÊU CHẬM)
local isCasting200 = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Y and not isCasting200 then
        isCasting200 = true
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if not hrp then isCasting200 = false return end
        
        -- 1. Dùng lực vật lý đưa Gojo bay lơ lửng lên trời mượt mà
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(0, math.huge, 0)
        bp.Position = hrp.Position + Vector3.new(0, 40, 0)
        bp.Parent = hrp
        
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
        
        task.wait(2)
        
        -- Vị trí TRÊN ĐẦU nhân vật (Cộng thêm 15 studs theo trục Y hướng lên trên)
        local topHeadPos = hrp.Position + Vector3.new(0, 15, 0)
        local midTargetPos = topHeadPos + hrp.CFrame.LookVector * 30 -- Điểm giao nhau ở phía trước trên cao
        
        -- 2. Tạo 2 quả cầu Xanh Đỏ TRÊN ĐẦU, dạt rộng sang hai bên cánh theo hình chữ V (/ \)
        local blueBall = createCleanBall(Color3.fromRGB(0, 100, 255), 18, topHeadPos)
        local redBall = createCleanBall(Color3.fromRGB(255, 0, 50), 18, topHeadPos)
        
        local leftCurve = topHeadPos + (hrp.CFrame.RightVector * -30) + (hrp.CFrame.LookVector * 15)
        local rightCurve = topHeadPos + (hrp.CFrame.RightVector * 30) + (hrp.CFrame.LookVector * 15)
        
        -- Giai đoạn 1: Bắn dạt ra hai góc (2 giây)
        TweenService:Create(blueBall, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = leftCurve}):Play()
        TweenService:Create(redBall, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = rightCurve}):Play()
        task.wait(2)
        
        -- Giai đoạn 2: Ép lượn vòng cung ngược vào điểm giữa TRÊN CAO (3 giây - Tổng cộng 5s tụ lực siêu chậm)
        TweenService:Create(blueBall, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = midTargetPos}):Play()
        TweenService:Create(redBall, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = midTargetPos}):Play()
        task.wait(3)
        
        blueBall:Destroy()
        redBall:Destroy()
        
        -- 3. GIẢI PHÓNG TỬ 200% KHỔNG LỒ TỪ TRÊN CAO BẮN XUỐNG
        local megaPurple = createCleanBall(Color3.fromRGB(140, 0, 255), 45, midTargetPos)
        local targetPos = megaPurple.Position + hrp.CFrame.LookVector * 600
        
        -- Bay đi càn quét với tốc độ vừa phải, nhìn cực hoành tráng (1.5 giây)
        local tweenMega = TweenService:Create(megaPurple, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = targetPos,
            Size = Vector3.new(80, 80, 80)
        })
        tweenMega:Play()
        tweenMega.Completed:Connect(function() megaPurple:Destroy() end)
        
        -- Hạ cánh rơi tự do xuống đất
        task.wait(0.5)
        bp:Destroy()
        bg:Destroy()
        isCasting200 = false
    end
end)

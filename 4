local EliteLabel = StatusGroup:AddLabel("Elite Hunter : Checking...")
local MoonLabel = StatusGroup:AddLabel("Moon : Checking...")

local function GetMoonPhase()

    local Time = Lighting.ClockTime

    if Time >= 0 and Time <= 1 then
        return "🌕 5/5"
    elseif Time <= 2 then
        return "🌖 4/5"
    elseif Time <= 3 then
        return "🌗 3/5"
    elseif Time <= 4 then
        return "🌘 2/5"
    else
        return "🌑 1/5"
    end
end

local function UpdateStatus()

    -- MIRAGE
    if Workspace:FindFirstChild("Mirage Island") then
        MirageLabel:SetText("Mirage Island : ✅")
    else
        MirageLabel:SetText("Mirage Island : ❌")
    end

    -- KITSUNE
    if Workspace:FindFirstChild("Kitsune Island") then
        KitsuneLabel:SetText("Kitsune Island : ✅")
    else
        KitsuneLabel:SetText("Kitsune Island : ❌")
    end

    -- PREHISTORIC
    if Workspace:FindFirstChild("Prehistoric Island") then
        PrehistoricLabel:SetText("Prehistoric Island : ✅")
    else
        PrehistoricLabel:SetText("Prehistoric Island : ❌")
    end

    -- FROZEN
    if Workspace:FindFirstChild("Frozen Dimension") then
        FrozenLabel:SetText("Frozen Dimension : ✅")
    else
        FrozenLabel:SetText("Frozen Dimension : ❌")
    end

    -- RIP INDRA
    local RipIndra =
        Workspace.Enemies:FindFirstChild("rip_indra True Form")
        or Workspace.Enemies:FindFirstChild("rip_indra")

    if RipIndra then
        RipIndraLabel:SetText("Rip Indra : ✅")
    else
        RipIndraLabel:SetText("Rip Indra : ❌")
    end

    -- DOUGH KING
    if Workspace.Enemies:FindFirstChild("Dough King") then
        DoughKingLabel:SetText("Dough King : ✅")
    else
        DoughKingLabel:SetText("Dough King : ❌")
    end

    -- ELITE
    EliteLabel:SetText("Elite Hunter : ⚔️ 93")

    -- MOON
    MoonLabel:SetText("Moon : "..GetMoonPhase())
end

task.spawn(function()
    while task.wait(5) do
        pcall(UpdateStatus)
    end
end)


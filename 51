-- Hiệu ứng Đóng/Mở mượt mà (Tween Animation)
local isTweening = false
local originalSize = UDim2.new(0, 700, 0, 420)

MinBtn.MouseButton1Click:Connect(function()
	if isTweening then return end
	isTweening = true
	
	local tween = TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 700, 0, 0)
	})
	tween:Play()
	tween.Completed:Connect(function()
		Main.Visible = false
		OpenBtn.Visible = true
		isTweening = false
	end)
end)

OpenBtn.MouseButton1Click:Connect(function()
	if isTweening then return end
	isTweening = true
	
	Main.Visible = true
	OpenBtn.Visible = false
	
	local tween = TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = originalSize
	})
	tween:Play()
	tween.Completed:Connect(function()
		isTweening = false
	end)
end)

-- Hệ thống Kéo thả UI chống trôi vị trí (Smooth Drag System)
local dragging, dragStart, startPos

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)


--------------------------------------------------
-- CHARACTER & NOCLIP CHUẨN
--------------------------------------------------
local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Char = GetCharacter()
    return Char:WaitForChild("HumanoidRootPart")
end

local NoclipConnection
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local Char = LocalPlayer.Character
                if Char then
                    for _, v in ipairs(Char:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

--------------------------------------------------
-- ITEM CHECK
--------------------------------------------------
local function CheckItems()
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local Character = LocalPlayer.Character

    for _, item in ipairs(SpecialItems) do
        if Backpack and Backpack:FindFirstChild(item) then return true, item end
        if Character and Character:FindFirstChild(item) then return true, item end
    end
    return false, nil
end

--------------------------------------------------
-- CHEST LOGIC (TỐI ƯU SIÊU NHẸ)
--------------------------------------------------
local function InitialChestScan()
    table.clear(CachedChests)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.lower(obj.Name):find("chest") then
            table.insert(CachedChests, obj)
        end
    end
end

local function GetNearestChest()
    local Root = GetRoot()
    local nearest = nil
    local shortest = math.huge

    -- Lọc ngược từ dưới lên để an toàn khi xóa phần tử
    for i = #CachedChests, 1, -1 do
        local chest = CachedChests[i]
        
        if not chest or not chest.Parent then
            table.remove(CachedChests, i)
        else
            local dist = (Root.Position - chest.Position).Magnitude
            if dist < shortest then
                shortest = dist
                nearest = chest
            end
        end
    end
    return nearest
end

--------------------------------------------------
-- TỐC BIẾN (TELEPORT)
--------------------------------------------------
local function TP(targetPosition)
    local Root = GetRoot()
    if not Root then return end

    ToggleNoclip(true)

    -- Bay trực tiếp do Executor đã lo Anti-Ban
    Root.CFrame = CFrame.new(targetPosition + Vector3.new(0, TELEPORT_HEIGHT, 0))
    
    task.wait(TELEPORT_DELAY)
    ToggleNoclip(false)
end

--------------------------------------------------
-- COLLECT CHEST
--------------------------------------------------
local function CollectChest(chest)
    if not chest or not chest.Parent then return end

    UpdateStatus("Collecting "..chest.Name)
    TP(chest.Position)

    pcall(function()
        if firetouchinterest then
            firetouchinterest(GetRoot(), chest, 0)
            task.wait()
            firetouchinterest(GetRoot(), chest, 1)
        end
    end)

    task.wait(math.random(15,30)/100)
end

--------------------------------------------------
-- SERVER HOP (CÓ LƯU LẠI SERVER ĐÃ VÀO)
--------------------------------------------------
local function HopServer()
    UpdateStatus("Searching server...")

    local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function() return game:HttpGet(url) end)

    if not success then
        UpdateStatus("HTTP failed, retrying...")
        task.wait(5)
        return
    end

    local data = HttpService:JSONDecode(response)

    for _, server in ipairs(data.data) do
        -- Kiểm tra server chưa vào & vắng người
        if server.id ~= game.JobId and server.playing < server.maxPlayers and server.playing <= 8 and not JoinedServers[server.id] then
            
            JoinedServers[server.id] = true
            SaveServers()

            UpdateStatus("Joining "..server.playing.."/"..server.maxPlayers)
            task.wait(1)

            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
            break
        end
    end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
UpdateStatus("Started")

-- Quét rương 1 lần duy nhất lúc bật script để chống tụt FPS
InitialChestScan() 

task.spawn(function()
    while getgenv().AutoChest do
        local HasItem, ItemName = CheckItems()

        if HasItem then
            UpdateStatus("FOUND "..ItemName)
            getgenv().AutoChest = false
            break
        end

        local Chest = GetNearestChest()

        if Chest then
            CollectChest(Chest)
        else
            UpdateStatus("No chest found. Hopping...")
            task.wait(2)
            HopServer()
            task.wait(10) -- Nghỉ một chút chờ game dịch chuyển
        end

        task.wait(math.random(SEARCH_DELAY*10, SEARCH_DELAY*20)/10)
    end
end)

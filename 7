-- SERVER
--// =========================

getgenv().JoinJobId = ""

ServerGroup:AddInput("JobIdInput", {
    Default = "",
    Numeric = false,
    Finished = false,

    Text = "Input Your JobID Here",
    Placeholder = "Input Here",

    Callback = function(Value)
        getgenv().JoinJobId = Value
    end
})

ServerGroup:AddToggle("SpamJoin", {
    Text = "Spam Join",
    Default = false,

    Callback = function(Value)
        getgenv().SpamJoin = Value
    end
})

ServerGroup:AddButton({
    Text = "Join Server",

    Func = function()

        if getgenv().JoinJobId ~= "" then

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                getgenv().JoinJobId,
                LocalPlayer
            )

        end
    end
})

ServerGroup:AddButton({
    Text = "Copy JobId",

    Func = function()
        setclipboard(game.JobId)
    end
})

ServerGroup:AddButton({
    Text = "Rejoin Server",

    Func = function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
})


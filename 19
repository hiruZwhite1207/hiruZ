        pcall(function()

            if getgenv().AutoChest then

                local chest = GetChest()

                if chest then

                    Notify("Đang qua rương")

                    MoveTo(chest.pos)

                    getgenv().LootedChests[chest.id] = true

                    task.wait(0.15)

                else


-- ==========================================
-- XÂY DỰNG GIAO DIỆN CÀI ĐẶT
-- ==========================================
TabCaiDat:AddToggle({
    Name = "Chọn Phe Hải Tặc (Tắt = Hải Quân)",
    Default = true,
    Callback = function(Value)
        if Value then
            getgenv().Team = "Pirates"
            OrionLib:MakeNotification({Name = "Hệ Thống", Content = "Đã đổi sang phe Hải Tặc!", Time = 2})
        else
            getgenv().Team = "Marines"
            OrionLib:MakeNotification({Name = "Hệ Thống", Content = "Đã đổi sang phe Hải Quân!", Time = 2})
        end
        SetKaitunConfig() -- Cập nhật lại config nếu đổi phe
    end    
})

TabCaiDat:AddParagraph("Lưu ý:","Hãy chọn phe ở Tab Cài Đặt TRƯỚC khi bấm chạy Script nhé!")

-- ==========================================
-- XÂY DỰNG GIAO DIỆN CHỌN SCRIPT
-- ==========================================
TabChinh:AddDropdown({
    Name = " Chọn Script Trong Kho",
    Default = "",
    Options = DanhSachTen,
    Callback = function(Value)
        ScriptCanChay = KhoScriptBloxFruits[Value]
    end    
})

TabChinh:AddButton({
    Name = " CHẠY SCRIPT ĐÃ CHỌN ",
    Callback = function()
        if ScriptCanChay ~= "" then
            OrionLib:MakeNotification({Name = "Đang Tải...", Content = "Chuẩn bị khởi chạy Script. Vui lòng chờ!", Time = 3})
            task.wait(0.5)
            loadstring(game:HttpGet(ScriptCanChay))()
        else
            OrionLib:MakeNotification({Name = "Lỗi", Content = "Vui lòng chọn một Script từ danh sách trước!", Time = 3})
        end
    end    
})


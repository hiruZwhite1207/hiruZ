UpdateStatus("HIRUZ STARTED")

task.spawn(function()
    while getgenv().AutoChest do
        task.wait(0.2)

        local HasItem,ItemName = CheckSpecialItems()
        if HasItem then
            UpdateStatus("Found "..ItemName)
            getgenv().AutoChest = false
            break
        end

        -- KIỂM TRA ĐỦ 9 RƯƠNG THÌ TỰ SÁT
        if ChestsCollectedSinceReset >= RESET_AFTER_CHESTS then
            ResetCharacter()
        end

        local Chests = GetAllChests()

        if #Chests > 0 then
            -- Chỉ lấy rương gần nhất để ăn
            local Chest = Chests[1]
            if Chest and Chest.Parent then
                UpdateStatus("Collecting "..Chest.Name)
                TPChest(Chest)
                
                UpdateCount()
                ChestsCollectedSinceReset = ChestsCollectedSinceReset + 1
                
                task.wait(0.25)
            end
        else
            UpdateStatus("No chest found")
            ResetCharacter()
            task.wait(3)
            
            if #GetAllChests() <= 0 then
                HopServer()
                task.wait(10)
            end
        end
    end
end)
